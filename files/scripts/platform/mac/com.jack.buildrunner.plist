<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.jack.buildrunner</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>PLACEHOLDER_HOME/.jack/jack-build-runner.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>PLACEHOLDER_HOME/.jack/runner.log</string>
  <key>StandardErrorPath</key><string>PLACEHOLDER_HOME/.jack/runner.log</string>
</dict></plist>
