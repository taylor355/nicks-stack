nicks-stack.resolved.json
__pycache__/
*.pyc

# python bytecode (bootstrap excludes it, keep it out of git too)
__pycache__/
*.pyc

# Derived, secret-bearing runtime files. These are generated on the VM under
# /root/.hermes and must never be committed; listed here as a hard backstop in
# case one is ever copied into a checkout.
secrets.env
mcp.env
op_cache.json

# Derived on a deployed machine inside the /opt/nicks-stack checkout. These are
# regenerated by bootstrap.sh / jack manifest and must never be committed —
# untracked, they made every deploy report "uncommitted changes" and made the
# git line in `jack doctor` useless as a signal.
/backups/
/stage/
/composio-venv/
/platform-manifest.json
